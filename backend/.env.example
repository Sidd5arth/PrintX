NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Set true to use in-memory sample data (no DB2 required)
DB2_MOCK=true

# IBM DB2 connection (used when DB2_MOCK=false)
DB2_DSN=DATABASE=PRINTXDB;HOSTNAME=localhost;PORT=50000;PROTOCOL=TCPIP;UID=db2inst1;PWD=password;
DB2_SCHEMA=PRINTX

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# PDF
PDF_TIMEOUT_MS=30000
